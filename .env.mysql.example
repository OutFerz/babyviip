# Copia lo que necesites a tu .env para la evaluación con MySQL.
#
# Levantar solo MySQL + web (sin Postgres):
#   docker compose -f docker-compose.yml -f docker-compose.mysql.yml up -d --build mysql_db web
#
DATABASE_ENGINE=mysql
MYSQL_HOST=mysql_db
MYSQL_PORT=3306

# Credenciales de la app (mismas vars que con Postgres)
DATABASE_NAME=babyviip_db
DATABASE_USER=admin
DATABASE_PASSWORD=pass_seguro_123

# Obligatorio para la imagen oficial mysql:8
MYSQL_ROOT_PASSWORD=cambiar_root_mysql
